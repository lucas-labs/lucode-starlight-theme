{
    "semi": true,
    "singleQuote": true,
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "es5",
    "printWidth": 100,
    "arrowParens": "always",
    "plugins": ["prettier-plugin-astro"],
    "overrides": [
        {
            "files": ["*.astro"],
            "options": {
                "parser": "astro"
            }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2,
                "printWidth": 200
            }
        },
        {
            "files": ["*.md", "*.mdx"],
            "options": {
                "tabWidth": 2,
                "embeddedLanguageFormatting": "off"
            }
        }
    ]
}
